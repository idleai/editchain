{
  "name": "editchain-history",
  "displayName": "EditChain History",
  "description": "Unified engineering history explorer — EditChain operations overlaid with live Git history.",
  "version": "0.1.10",
  "publisher": "ambientlight",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ambientlight/editchain.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:editchain-history.open",
    "onCommand:editchain-history.startLive",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "resourceLabelFormatters": [
      {
        "scheme": "editchain-hunk",
        "formatting": {
          "label": "${query.label}",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      }
    ],
    "commands": [
      { "command": "editchain-history.multiplayerRequest", "title": "EditChain: Create Multiplayer Join Request" },
      { "command": "editchain-history.multiplayerHost", "title": "EditChain: Host Shared History / Invite Device" },
      { "command": "editchain-history.multiplayerJoin", "title": "EditChain: Join Shared History" },
      { "command": "editchain-history.multiplayerStatus", "title": "EditChain: Show Multiplayer Status" },
      { "command": "editchain-history.multiplayerRemove", "title": "EditChain: Remove Shared Device" },
      { "command": "editchain-history.multiplayerStop", "title": "EditChain: Stop Sharing History" },
      { "command": "editchain-history.multiplayerCleanup", "title": "EditChain: Clean Up Multiplayer Tunnels" },
      {
        "command": "editchain-history.devTunnelsSpike",
        "title": "EditChain: Run Dev Tunnels Spike"
      },
      {
        "command": "editchain-history.devTunnelsCleanup",
        "title": "EditChain: Clean Up Dev Tunnels Spike"
      },
      {
        "command": "editchain-history.open",
        "title": "EditChain: Open History Explorer"
      },
      {
        "command": "editchain-history.startLive",
        "title": "EditChain: Resume Live History"
      },
      {
        "command": "editchain-history.stopLive",
        "title": "EditChain: Pause Live History"
      },
      {
        "command": "editchain-history.showTrackingStatus",
        "title": "EditChain: Show Tracking Status"
      },
      {
        "command": "editchain-history.humanWork",
        "title": "EditChain: Show Human Work Coverage"
      },
      {
        "command": "editchain-history.startTracking",
        "title": "EditChain: Resume Human Work Tracking"
      },
      {
        "command": "editchain-history.stopTracking",
        "title": "EditChain: Pause Human Work Tracking"
      }
    ],
    "configuration": {
      "title": "EditChain History",
      "properties": {
        "editchain-history.peerPath": {
          "type": "string", "default": "",
          "description": "Optional path to editchain-peer. Defaults to the peer beside the native history service, then the bundled worker."
        },
        "editchain-history.servicePath": {
          "type": "string",
          "default": "",
          "description": "Path to the editchain-vscode-service binary. If empty, the workspace release build is preferred, with debug as a fallback."
        },
        "editchain-history.chainDir": {
          "type": "string",
          "default": ".editchain",
          "description": "Path to the EditChain directory relative to the workspace root."
        },
        "editchain-history.live.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Keep history up to date automatically while the panel is open, following Codex sessions and Git refs. Disable to open static history instead."
        },
        "editchain-history.live.sessionsPath": {
          "type": "string",
          "default": "",
          "description": "Codex sessions directory. Defaults to CODEX_HOME/sessions or ~/.codex/sessions. Relative paths use the workspace root."
        },
        "editchain-history.live.cliPath": {
          "type": "string",
          "default": "",
          "description": "Compatibility setting for the earlier live prototype. Retained live mode imports through the history service and does not use this binary."
        },
        "editchain-history.live.codexHelperPath": {
          "type": "string",
          "default": "",
          "description": "Path to codex-session-exporter. Defaults to the workspace helper release build, then PATH."
        },
        "editchain-history.tracking.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record local workspace code edits, editor lifecycle, and qualifying reads in EditChain. Focus only pauses timers; no focus events are stored."
        },
        "editchain-history.tracking.readDwellMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Continuous foreground visibility required for a reading indicator. Visibility does not prove comprehension."
        },
        "editchain-history.tracking.maxFileBytes": {
          "type": "number",
          "default": 8388608,
          "minimum": 1024,
          "maximum": 8388608,
          "description": "Maximum UTF-8 buffer size to capture, including unsaved text (default 8 MiB). Full before/after snapshots are retained for historical diffs. Skipped binary or oversized buffers produce explicit coverage gaps."
        }
      }
    }
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "test:multiplayer:relay": "node scripts/multiplayer-relay-e2e.cjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "install:local": "node scripts/install-local.mjs",
    "install:local:editor-origins": "node scripts/install-local.mjs --editor-origins",
    "package:editor-origins": "node scripts/package-editor-origins.mjs",
    "perf:service": "node scripts/service-perf.mjs",
    "perf:renderer": "node scripts/renderer-update-perf.cjs",
    "ui:vscode": "xvfb-run -a npx wdio run ./test/vscode/wdio.conf.ts",
    "ui:vscode:renderer": "xvfb-run -a npx wdio run ./test/vscode/wdio.renderer.conf.ts",
    "ui:vscode:visual": "xvfb-run -a npx wdio run ./test/vscode/wdio.visual.conf.ts",
    "build:renderer": "bash scripts/build-history-renderer.sh",
    "build:gpu": "npm run build:renderer",
    "test:harness": "node --test test/harness/*.test.js",
    "test:rust-smoke": "node --test --test-reporter=tap test/harness/rustSmoke.test.js",
    "ui:vscode:live": "xvfb-run -a npx wdio run ./test/vscode/wdio.live.conf.ts",
    "ui:vscode:capture": "xvfb-run -a -s '-screen 0 1440x1000x24' npx wdio run ./test/vscode/wdio.capture.conf.ts",
    "ui:vscode:capture:baseline": "bash scripts/test-capture-baseline.sh",
    "test:capture:types": "tsc -p test/vscode/tsconfig.capture.json && node --check test/vscode/capture-probe/extension.js",
    "ui:vscode:work": "xvfb-run -a -s '-screen 0 1440x1000x24' npx wdio run ./test/vscode/wdio.work.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "puppeteer-core": "^23.11.1",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "wdio-vscode-service": "^8.0.0"
  },
  "overrides": {
    "@vscode/vsce": {
      "cheerio": "1.0.0"
    }
  },
  "dependencies": {
    "@microsoft/dev-tunnels-connections": "1.3.56",
    "@microsoft/dev-tunnels-contracts": "1.3.56",
    "@microsoft/dev-tunnels-management": "1.3.56",
    "@microsoft/dev-tunnels-ssh": "3.12.42",
    "@microsoft/dev-tunnels-ssh-tcp": "3.12.42",
    "vscode-jsonrpc": "4.0.0"
  }
}
